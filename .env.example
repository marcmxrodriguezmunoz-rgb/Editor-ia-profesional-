# Local single-user application. Never expose this server to the Internet without auth.
APP_ORIGIN=http://127.0.0.1:3000
# Optional: API calls send audio/transcripts to OpenAI and may incur costs.
OPENAI_API_KEY=
AI_MODEL=gpt-4o-mini
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
# Optional system Chromium, otherwise Remotion downloads Chrome Headless Shell.
# CHROME_PATH=/usr/bin/chromium
